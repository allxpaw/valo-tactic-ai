# Скопируйте в .env и впишите свои значения. Файл .env НЕ коммитить.

# Authorization key из личного кабинета GigaChat API (developers.sber.ru)
GIGACHAT_AUTH_KEY=MDFhMDhhMDQtMTA5NC03ZGU4LTk5MDgtNTQ5ZTcwNzMwMTM5OjVmODM2OTEwLTdkNTYtNGVhYS05ZDhmLWRjNTk3MWViNGNlZQ==
GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_MODEL=GigaChat

# Сертификат Минцифры (рекомендуется): путь к .cer/.pem файлу
GIGACHAT_CA_BUNDLE=
# Или, только для учебного запуска, отключить проверку SSL: false
GIGACHAT_VERIFY_SSL=false

# Параметры RAG (необязательно)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=3
